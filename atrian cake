  mkProduct(9, 'شیرینی خشک مخصوص', 'شیرینی', 390000, 460000, 20, 'شیرینی خشک سنتی با مغز گردو، پسته و خرما.'),
  mkProduct(10, 'شیرینی گردویی', 'شیرینی', 480000, 0, 16, 'شیرینی گردویی با مغز پر از گردوی تازه.'),
