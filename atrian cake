          '<button onclick="cartChangeQty(' + idx + ',-1)">−</button>' +
          '<span style="min-width:22px;text-align:center;font-weight:700">' + fa(l.qty) + '</span>' +
          '<button onclick="cartChangeQty(' + idx + ',1)">+</button>' +
          '<button style="background:none;color:#d4788f;margin-right:8px;width:auto" onclick="cartRemove(' + idx + ')">حذف</button>' +
        '</div>' +
      '</div>' +
      '<b style="font-size:12px">' + money(p.price * l.qty) + '</b>' +
    '</div>';
  }).join('');

  host.innerHTML = '<button class="modal-close" onclick="closeCart()">×</button>' +
    '<h2>سبد خرید</h2>' + lines +
    '<div class="cart-total"><span>جمع کل</span><span>' + money(total) + '</span></div>' +
    '<p style="font-size:11.5px;color:var(--muted);line-height:1.9;margin:8px 0 16px">هزینه ارسال پس از انتخاب روش تحویل محاسبه می‌شود.</p>' +
    '<button class="btn btn-primary btn-block" onclick="openCheckout()">ادامه و ثبت سفارش</button>';
}

function cartChangeQty(i, d){
  var l = state.cart[i];
  if(!l) return;
  var p = state.products.find(function(x){ return x.id === l.id; });
  if(!p) return;
  if(d > 0 && l.qty >= Number(p.stock || 0)){ showToast('موجودی کافی نیست'); return; }
  l.qty += d;
  if(l.qty <= 0) state.cart.splice(i, 1);
  saveState(); updateCartCount(); renderCartModal();
}
function cartRemove(i){
  state.cart.splice(i, 1);
  saveState(); updateCartCount(); renderCartModal();
}

