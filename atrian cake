function submitOrder(fd){
  var need = {};
  state.cart.forEach(function(l){ need[l.id] = (need[l.id] || 0) + l.qty; });
  for(var pid in need){
    var p = state.products.find(function(x){ return x.id === Number(pid); });
    if(!p || Number(p.stock || 0) < need[pid]){
      showToast('موجودی «' + (p ? p.name : 'محصول') + '» کافی نیست');
      return;
    }
  }
  var items = state.cart.map(function(l){
    var p = state.products.find(function(x){ return x.id === l.id; });
    return {
      id: p.id, name: p.name, qty: l.qty,
      price: p.price, total: p.price * l.qty
    };
  });
  var total = items.reduce(function(s,i){ return s + i.total; }, 0);

  var order = {
    id: uid('AT'),
    date: new Date().toLocaleString('fa-IR'),
    ts: Date.now(),
    name: fd.get('name'),
    phone: fd.get('phone'),
    address: fd.get('address'),
    shipping: fd.get('shipping'),
    payment: fd.get('payment'),
    note: fd.get('note') || '',
    items: items,
    total: total,
    status: 'در انتظار بررسی',
    reply: ''
  };

  for(var pid in need){
    var p = state.products.find(function(x){ return x.id === Number(pid); });
    if(p) p.stock = Math.max(0, Number(p.stock || 0) - need[pid]);
  }

  state.orders.unshift(order);
  state.cart = [];
  saveState();
  closeCheckout();
  updateCartCount();
  renderProducts();
  showToast('سفارش ' + order.id + ' ثبت شد ✿');
}

