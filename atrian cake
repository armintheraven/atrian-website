  var r = new FileReader();
  r.onload = function(){
    try{
      var d = JSON.parse(r.result);
      if(!d.products) throw new Error();
      state.products = d.products || [];
      state.cart = d.cart || [];
      state.orders = d.orders || [];
      state.customOrders = d.customOrders || [];
      state.settings = Object.assign({}, DEFAULTS_SETTINGS, d.settings || {});
