function makeSvg(c1, c2, kind){
  var s = '<svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 400 400">';
  s += '<defs><linearGradient id="g" x1="0" x2="1" y1="0" y2="1">';
  s += '<stop offset="0" stop-color="' + c1 + '"/>';
  s += '<stop offset="1" stop-color="' + c2 + '"/>';
  s += '</linearGradient></defs>';
  s += '<rect width="400" height="400" fill="' + c2 + '20"/>';
  if(kind === 'cake'){
    s += '<ellipse cx="200" cy="320" rx="130" ry="14" fill="#00000015"/>';
    s += '<rect x="80" y="230" width="240" height="90" rx="16" fill="url(#g)"/>';
    s += '<rect x="80" y="230" width="240" height="18" rx="9" fill="#ffffff60"/>';
    s += '<rect x="110" y="170" width="180" height="70" rx="14" fill="url(#g)"/>';
    s += '<rect x="110" y="170" width="180" height="16" rx="8" fill="#ffffff60"/>';
    s += '<rect x="140" y="120" width="120" height="55" rx="12" fill="url(#g)"/>';
    s += '<circle cx="200" cy="105" r="12" fill="#e0576e"/>';
  } else if(kind === 'cookie'){
    s += '<circle cx="200" cy="200" r="115" fill="url(#g)"/>';
    s += '<circle cx="160" cy="160" r="14" fill="' + c2 + '"/>';
    s += '<circle cx="245" cy="170" r="12" fill="' + c2 + '"/>';
    s += '<circle cx="180" cy="245" r="13" fill="' + c2 + '"/>';
    s += '<circle cx="250" cy="238" r="11" fill="' + c2 + '"/>';
    s += '<circle cx="215" cy="205" r="10" fill="' + c2 + '"/>';
  } else if(kind === 'pastry'){
    s += '<g transform="translate(200,200) rotate(45)">';
    s += '<rect x="-100" y="-100" width="200" height="200" rx="28" fill="url(#g)"/>';
    s += '<rect x="-72" y="-72" width="144" height="144" rx="18" fill="none" stroke="' + c2 + '" stroke-width="6" opacity=".55"/>';
    s += '</g><circle cx="200" cy="200" r="18" fill="' + c2 + '"/>';
  } else if(kind === 'pack'){
    s += '<rect x="80" y="150" width="240" height="175" rx="18" fill="url(#g)"/>';
    s += '<rect x="80" y="150" width="240" height="55" rx="18" fill="' + c2 + '" opacity=".5"/>';
    s += '<rect x="185" y="150" width="30" height="175" fill="#ffffff70"/>';
    s += '<rect x="80" y="215" width="240" height="22" fill="#ffffff60"/>';
  } else {
    s += '<circle cx="200" cy="200" r="115" fill="url(#g)"/>';
  }
  s += '</svg>';
  return 'data:image/svg+xml;charset=utf-8,' + encodeURIComponent(s);
}

var CAT_COLORS = {
