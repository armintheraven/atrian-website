function renderImageGrid(images){
  window.__editImages = images.slice();
  var host = document.getElementById('imageGrid');
  var html = images.map(function(src, i){
    return '<div class="image-slot">' +
      '<img src="' + src + '">' +
      '<button class="remove" onclick="removeEditImage(' + i + ')">×</button>' +
    '</div>';
  }).join('');
  html += '<label class="upload-slot">' +
    '<input type="file" accept="image/*" multiple onchange="addEditImages(event)">' +
    '＋' +
  '</label>';
  host.innerHTML = html;
}
function removeEditImage(i){
  window.__editImages.splice(i, 1);
  renderImageGrid(window.__editImages);
}
function addEditImages(ev){
  var files = Array.from(ev.target.files || []);
  if(!files.length) return;
  var promises = files.map(function(f){
    if(f.size > 2*1024*1024){
      showToast('حجم ' + f.name + ' بیشتر از ۲ مگابایته، رد شد.');
      return Promise.resolve(null);
    }
    return fileToDataUrl(f);
  });
  Promise.all(promises).then(function(results){
    results.forEach(function(r){ if(r) window.__editImages.push(r); });
    renderImageGrid(window.__editImages);
  });
}

function saveProduct(id){
  var name = document.getElementById('fName').value.trim();
  if(!name){ showToast('نام محصول را وارد کن'); return; }
  var cat = document.getElementById('fCat').value;
  var price = Math.max(0, Number(document.getElementById('fPrice').value) || 0);
  var oldPrice = Math.max(0, Number(document.getElementById('fOldPrice').value) || 0);
  var stock = Math.max(0, Number(document.getElementById('fStock').value) || 0);
  var active = document.getElementById('fActive').value === '1';
  var desc = document.getElementById('fDesc').value.trim();
  var images = window.__editImages.slice();

  if(!images.length){
    var c = CAT_COLORS[cat] || ['#e79bb0','#d4788f','cake'];
    images = [makeSvg(c[0], c[1], c[2])];
  }

  if(id === 0){
    var newId = Math.max.apply(null, [0].concat(state.products.map(function(x){ return x.id; }))) + 1;
    state.products.push({ id: newId, name: name, category: cat, price: price, oldPrice: oldPrice, stock: stock, desc: desc, images: images, active: active });
  } else {
    var idx = state.products.findIndex(function(x){ return x.id === id; });
    if(idx >= 0){
      state.products[idx] = { id: id, name: name, category: cat, price: price, oldPrice: oldPrice, stock: stock, desc: desc, images: images, active: active };
    }
  }
  saveState();
  renderProducts();
  renderMenuCategories();
  switchTab('products');
  showToast('محصول ذخیره شد');
}

function deleteProduct(id){
  var p = state.products.find(function(x){ return x.id === id; });
  if(!p) return;
  if(!confirm('محصول «' + p.name + '» حذف شود؟')) return;
  state.products = state.products.filter(function(x){ return x.id !== id; });
  state.cart = state.cart.filter(function(l){ return l.id !== id; });
  saveState();
  renderProducts();
  renderMenuCategories();
  switchTab('products');
  showToast('حذف شد');
}

