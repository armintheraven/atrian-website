var activeQty = 1;
function changeQty(d){
  var p = activeProduct;
  if(!p) return;
  var inCart = state.cart.filter(function(l){ return l.id === p.id; }).reduce(function(n,l){ return n + l.qty; }, 0);
  var next = activeQty + d;
  if(next < 1) return;
  if(inCart + next > Number(p.stock || 0)){ showToast('موجودی کافی نیست'); return; }
  activeQty = next;
  var el = document.getElementById('qtyLabel');
  if(el) el.textContent = fa(activeQty);
}

function addToCart(){
  var p = activeProduct;
  if(!p) return;
  var inCart = state.cart.filter(function(l){ return l.id === p.id; }).reduce(function(n,l){ return n + l.qty; }, 0);
  if(inCart + activeQty > Number(p.stock || 0)){ showToast('موجودی کافی نیست'); return; }
  var found = state.cart.find(function(l){ return l.id === p.id; });
  if(found) found.qty += activeQty;
  else state.cart.push({ id: p.id, qty: activeQty });
  saveState();
  updateCartCount();
  closeProduct();
  showToast('به سبد اضافه شد ✿');
}

