<!doctype html>
<html lang="fa" dir="rtl">
<head>
<meta charset="utf-8">
<meta name="viewport" content="width=device-width,initial-scale=1">
<title>عطریان | شیرینی دست‌ساز</title>
<link rel="preconnect" href="https://fonts.googleapis.com">
<link href="https://fonts.googleapis.com/css2?family=Vazirmatn:wght@400;500;600;700;800&display=swap" rel="stylesheet">
<style>
:root{
  --pink:#e79bb0; --pink-d:#d4788f; --pink-l:#fbe4ea;
  --ink:#4a3a41; --muted:#9b8891; --line:#f0dfe6;
  --white:#fffdfd; --cream:#fdf4f6;
  --gold:#e8c07d; --mint:#8fc4ae;
  --shadow:0 12px 40px #c98ba018;
  --radius:18px;
}
*{box-sizing:border-box}
html,body{margin:0;padding:0}
body{
  font-family:Vazirmatn,Tahoma,sans-serif;color:var(--ink);
  background:var(--cream);min-height:100vh;
  background-size:cover;background-position:center;background-attachment:fixed;
  background-repeat:no-repeat;
}
button,input,select,textarea{font-family:inherit}
button{cursor:pointer;border:0;background:none;color:inherit}
a{color:inherit;text-decoration:none}
img{max-width:100%;display:block}
.wrap{max-width:1200px;margin:0 auto;padding:0 18px}

/* TICKER */
.ticker{
  background:linear-gradient(90deg,#d4788f,#e79bb0,#f0b7c7,#e79bb0,#d4788f);
  background-size:200% 100%;
  color:#fff;font-size:12.5px;padding:10px 0;overflow:hidden;
  animation:tickerBg 8s linear infinite;
}
@keyframes tickerBg{0%{background-position:0 0}100%{background-position:200% 0}}
.ticker-inner{white-space:nowrap;animation:scrollTicker 25s linear infinite;display:inline-block;padding-right:100%}
.ticker span{margin:0 24px;display:inline-block}
@keyframes scrollTicker{0%{transform:translateX(0)}100%{transform:translateX(-50%)}}

/* HEADER */
header{
  background:rgba(255,253,253,0.92);
  backdrop-filter:blur(12px);
  position:sticky;top:0;z-index:50;
  border-bottom:1px solid var(--line);
}
.header-inner{
  max-width:1200px;margin:0 auto;padding:0 18px;
  height:74px;display:flex;align-items:center;justify-content:space-between;gap:16px;
}
.hamburger{
  width:42px;height:42px;border-radius:12px;background:var(--pink-l);
  display:grid;place-items:center;color:var(--pink-d);font-size:20px;
  flex-shrink:0;transition:.2s;
}
.hamburger:hover{background:var(--pink);color:#fff}
.brand{display:flex;flex-direction:column;align-items:center;line-height:1;flex:1}
.brand-en{font-weight:800;color:var(--pink-d);letter-spacing:.2em;font-size:20px;direction:ltr}
.brand-fa{font-size:11px;color:var(--muted);margin-top:4px}
.header-actions{display:flex;gap:8px;align-items:center}
.icon-btn{
  width:42px;height:42px;border-radius:12px;background:var(--pink-l);
  display:grid;place-items:center;color:var(--pink-d);font-size:18px;
  position:relative;transition:.2s;
}
.icon-btn:hover{background:var(--pink);color:#fff}
.icon-btn .badge{
  position:absolute;top:-5px;left:-5px;background:var(--pink-d);color:#fff;
  font-size:10px;min-width:19px;height:19px;border-radius:10px;
  display:grid;place-items:center;padding:0 5px;font-weight:700;
}

/* MENU DRAWER */
.drawer-bg{
  position:fixed;inset:0;background:rgba(59,42,48,0.5);z-index:90;
  opacity:0;visibility:hidden;transition:.3s;
}
.drawer-bg.open{opacity:1;visibility:visible}
.drawer{
  position:fixed;top:0;right:-340px;width:320px;max-width:85vw;height:100%;
  background:#fff;z-index:100;transition:right .3s cubic-bezier(.2,.8,.2,1);
  display:flex;flex-direction:column;overflow-y:auto;
}
.drawer.open{right:0}
.drawer-header{
  padding:20px;display:flex;justify-content:space-between;align-items:center;
  background:linear-gradient(135deg,var(--pink-l),#fdf1f5);
  border-bottom:1px solid var(--line);
}
.drawer-header .brand-en{font-size:20px}
.drawer-close{
  width:36px;height:36px;border-radius:10px;background:#fff;
  display:grid;place-items:center;font-size:20px;color:var(--pink-d);
}
.drawer-section{padding:16px 20px;border-bottom:1px solid var(--line)}
.drawer-section h4{margin:0 0 10px;font-size:12px;color:var(--muted);font-weight:500;letter-spacing:.05em}
.drawer-item{
  display:flex;align-items:center;gap:12px;padding:12px 14px;border-radius:12px;
  cursor:pointer;font-size:14px;color:var(--ink);transition:.15s;
}
.drawer-item:hover{background:var(--pink-l);color:var(--pink-d)}
.drawer-item.active{background:var(--pink-d);color:#fff}
.drawer-item .icon{
  width:32px;height:32px;border-radius:10px;background:var(--pink-l);
  display:grid;place-items:center;font-size:16px;flex-shrink:0;
}
.drawer-item.active .icon{background:rgba(255,255,255,0.25)}
.drawer-footer{margin-top:auto;padding:20px;font-size:11px;color:var(--muted);text-align:center;line-height:2}

/* HERO */
.hero{
  position:relative;padding:80px 20px;text-align:center;overflow:hidden;
  background:linear-gradient(135deg,#fbe0e8,#fdf1f5 60%,#f3dfe6);
  background-size:cover;background-position:center;
}
.hero::before{
  content:"";position:absolute;inset:0;background:rgba(253,244,246,0.35);
  pointer-events:none;
}
.hero-inner{position:relative;max-width:800px;margin:0 auto}
.hero-eyebrow{
  display:inline-block;background:#fff;color:var(--pink-d);padding:6px 16px;
  border-radius:20px;font-size:11.5px;font-weight:600;margin-bottom:20px;
  box-shadow:0 4px 20px rgba(212,120,143,0.15);
}
.hero h1{
  font-size:clamp(28px,5vw,52px);line-height:1.45;margin:0 0 20px;
  font-weight:700;color:var(--ink);
}
.hero h1 em{font-style:normal;color:var(--pink-d);position:relative;display:inline-block}
.hero h1 em::after{
  content:"";position:absolute;bottom:6px;left:-4px;right:-4px;height:10px;
  background:var(--pink-l);z-index:-1;border-radius:5px;
}
.hero p{
  font-size:15.5px;color:#7c6970;line-height:2;max-width:560px;margin:0 auto 32px;
}
.hero-actions{display:flex;gap:12px;justify-content:center;flex-wrap:wrap}
.btn{
  display:inline-flex;align-items:center;gap:8px;padding:14px 28px;
  border-radius:30px;font-size:14px;font-weight:600;transition:.2s;
  border:1px solid transparent;cursor:pointer;
}
.btn-primary{background:var(--pink-d);color:#fff;box-shadow:0 10px 30px rgba(212,120,143,0.3)}
.btn-primary:hover{background:#c26a80;transform:translateY(-2px);box-shadow:0 14px 34px rgba(212,120,143,0.4)}
.btn-light{background:#fff;color:var(--pink-d);border-color:var(--line)}
.btn-light:hover{border-color:var(--pink-d);background:#fff}
.btn-block{width:100%;justify-content:center}
.btn-danger{background:#f4d8dc;color:#b0465a}

/* CAMPAIGNS */
.campaigns{padding:50px 0 20px}
.section-head{text-align:center;margin-bottom:32px}
.section-head .eyebrow{color:var(--pink-d);font-size:12px;font-weight:600;letter-spacing:.1em}
.section-head h2{font-size:clamp(22px,3.5vw,32px);margin:10px 0;font-weight:700}
.section-head p{color:var(--muted);font-size:14px;line-height:2;max-width:520px;margin:0 auto}
.campaign-grid{
  display:grid;grid-template-columns:repeat(auto-fit,minmax(240px,1fr));gap:18px;
}
.campaign-card{
  border-radius:var(--radius);padding:28px 24px;color:#fff;position:relative;
  overflow:hidden;min-height:150px;display:flex;flex-direction:column;justify-content:center;
  box-shadow:var(--shadow);
}
.campaign-card.c1{background:linear-gradient(135deg,#e79bb0,#d4788f)}
.campaign-card.c2{background:linear-gradient(135deg,#e8c07d,#d4a45c)}
.campaign-card.c3{background:linear-gradient(135deg,#8fc4ae,#5f9c85)}
.campaign-card h3{margin:0 0 8px;font-size:20px;font-weight:700}
.campaign-card p{margin:0;font-size:13px;opacity:.92;line-height:1.9}
.campaign-card .tag{
  display:inline-block;background:rgba(255,255,255,0.25);padding:4px 12px;
  border-radius:20px;font-size:11px;margin-bottom:12px;font-weight:600;
  align-self:flex-start;
}
.campaign-card::after{
  content:"";position:absolute;width:160px;height:160px;border-radius:50%;
  background:rgba(255,255,255,0.1);left:-40px;bottom:-60px;
}

/* PRODUCTS */
.products-section{padding:50px 0 60px}
.filters{
  display:flex;gap:8px;flex-wrap:wrap;justify-content:center;margin-bottom:28px;
}
.filter-btn{
  background:#fff;border:1px solid var(--line);padding:10px 20px;
  border-radius:24px;font-size:13px;color:#7c6970;font-weight:500;
  transition:.2s;
}
.filter-btn:hover{border-color:var(--pink);color:var(--pink-d)}
.filter-btn.active{background:var(--pink-d);color:#fff;border-color:var(--pink-d)}
.grid{
  display:grid;grid-template-columns:repeat(auto-fill,minmax(220px,1fr));
  gap:22px;
}
.card{
  background:#fff;border-radius:var(--radius);overflow:hidden;
  box-shadow:0 4px 20px rgba(212,120,143,0.06);
  cursor:pointer;transition:.25s;display:flex;flex-direction:column;
  border:1px solid transparent;
}
.card:hover{transform:translateY(-6px);box-shadow:var(--shadow);border-color:var(--pink-l)}
.card-image{
  height:200px;overflow:hidden;background:var(--pink-l);position:relative;
}
.card-image img{width:100%;height:100%;object-fit:cover;transition:.4s}
.card:hover .card-image img{transform:scale(1.06)}
.card-badge{
  position:absolute;top:12px;right:12px;background:var(--pink-d);color:#fff;
  font-size:11px;padding:5px 12px;border-radius:20px;font-weight:700;
  box-shadow:0 4px 12px rgba(212,120,143,0.4);
}
.card-badge.out{background:#9b8891}
.card-body{padding:16px;display:flex;flex-direction:column;flex:1}
.card-body h3{margin:0 0 8px;font-size:14.5px;font-weight:600;line-height:1.6}
.card-cat{font-size:11px;color:var(--muted);margin-bottom:10px}
.card-price{
  display:flex;align-items:center;gap:8px;margin-top:auto;flex-wrap:wrap;
}
.card-price .now{color:var(--pink-d);font-weight:700;font-size:15px}
.card-price .old{color:#c0aeb6;text-decoration:line-through;font-size:11.5px}

/* ABOUT */
.about{
  background:linear-gradient(135deg,#fbe4ea,#fdf1f5);
  padding:60px 20px;text-align:center;border-radius:32px;margin:20px 18px 60px;
}
.about h2{font-size:clamp(20px,3vw,28px);margin:0 0 16px;font-weight:700;line-height:1.7}
.about p{color:#7c6970;font-size:14px;line-height:2.2;max-width:560px;margin:0 auto}
.features{
  display:grid;grid-template-columns:repeat(auto-fit,minmax(180px,1fr));
  gap:16px;margin-top:36px;
}
.feature{
  background:#fff;padding:22px 18px;border-radius:16px;text-align:center;
  box-shadow:0 4px 16px rgba(212,120,143,0.06);
}
.feature .ico{
  width:48px;height:48px;border-radius:14px;background:var(--pink-l);
  color:var(--pink-d);display:grid;place-items:center;font-size:22px;
  margin:0 auto 12px;
}
.feature b{display:block;font-size:13.5px;margin-bottom:6px}
.feature p{margin:0;font-size:12px;color:var(--muted);line-height:1.9}

/* FOOTER */
footer{
  background:#4a3a41;color:#fbebf0;padding:44px 20px 24px;margin-top:20px;
}
.footer-inner{
  max-width:1200px;margin:0 auto;display:grid;
  grid-template-columns:repeat(auto-fit,minmax(200px,1fr));gap:32px;
}
footer h4{margin:0 0 14px;font-size:14px}
footer p,footer a{font-size:12.5px;color:#c8aeb8;line-height:2;display:block;margin:0 0 6px}
footer a:hover{color:var(--pink)}
.footer-brand{font-weight:800;color:#f6c8d6;letter-spacing:.2em;font-size:18px;direction:ltr;margin-bottom:8px}
.copyright{
  max-width:1200px;margin:32px auto 0;border-top:1px solid #6a565e;
  padding-top:18px;font-size:11px;color:#bfa5af;text-align:center;
}

/* MODAL */
.modal-bg{
  position:fixed;inset:0;background:rgba(59,42,48,0.6);z-index:150;
  display:none;align-items:center;justify-content:center;padding:16px;
  overflow-y:auto;
}
.modal-bg.open{display:flex}
.modal{
  background:#fff;border-radius:22px;width:100%;max-width:560px;
  max-height:92vh;overflow-y:auto;padding:26px;position:relative;
  box-shadow:0 24px 60px rgba(74,58,65,0.3);
}
.modal.modal-wide{max-width:1000px}
.modal-close{
  position:absolute;top:14px;left:14px;width:36px;height:36px;
  border-radius:50%;background:var(--pink-l);color:var(--pink-d);
  display:grid;place-items:center;font-size:20px;transition:.2s;
}
.modal-close:hover{background:var(--pink-d);color:#fff}
.modal h2{margin:0 0 20px;font-size:20px;font-weight:700}
.modal label{display:block;font-size:12px;color:#7c6970;margin:14px 0 6px;font-weight:500}
.modal input,.modal select,.modal textarea{
  width:100%;border:1.5px solid var(--line);border-radius:12px;padding:12px 14px;
  font-size:13.5px;background:#fff;color:var(--ink);outline:none;transition:.15s;
}
.modal input:focus,.modal select:focus,.modal textarea:focus{border-color:var(--pink)}
.modal textarea{resize:vertical;min-height:80px;line-height:1.9}
.row{display:grid;grid-template-columns:1fr 1fr;gap:12px}
.modal-actions{display:flex;gap:10px;margin-top:22px}
.modal-actions .btn{flex:1;justify-content:center}

/* PRODUCT DETAIL */
.gallery{
  background:var(--pink-l);border-radius:16px;overflow:hidden;
  height:min(52vh,420px);display:grid;place-items:center;margin-bottom:12px;
}
.gallery img{width:100%;height:100%;object-fit:cover}
.thumbs{display:flex;gap:8px;overflow-x:auto;padding:4px 0 8px}
.thumbs button{
  width:60px;height:60px;border-radius:12px;overflow:hidden;
  border:2px solid transparent;padding:0;flex-shrink:0;transition:.15s;
}
.thumbs button.active{border-color:var(--pink-d)}
.thumbs img{width:100%;height:100%;object-fit:cover}

/* CART */
.cart-line{
  display:grid;grid-template-columns:64px 1fr auto;gap:12px;
  padding:14px 0;border-bottom:1px solid var(--line);align-items:start;
}
.cart-line img{width:64px;height:64px;border-radius:12px;object-fit:cover}
.cart-line h4{margin:0 0 4px;font-size:13.5px;font-weight:600}
.cart-line small{color:var(--muted);font-size:11.5px}
.qty-ctrl{display:flex;gap:6px;align-items:center;margin-top:8px}
.qty-ctrl button{
  width:28px;height:28px;border-radius:8px;background:var(--pink-l);
  color:var(--pink-d);font-weight:700;font-size:15px;
}
.qty-ctrl button:hover{background:var(--pink);color:#fff}
.cart-total{
  display:flex;justify-content:space-between;padding:18px 0;
  font-weight:700;font-size:15px;border-top:1px dashed var(--line);
  margin-top:12px;
}
.cart-total span:last-child{color:var(--pink-d)}

/* ADMIN */
.admin-overlay{
  position:fixed;inset:0;background:#fdf4f6;z-index:200;
  display:none;flex-direction:column;overflow:hidden;
}
.admin-overlay.open{display:flex}
.admin-header{
  background:#fff;border-bottom:1px solid var(--line);
  padding:16px 20px;display:flex;justify-content:space-between;align-items:center;
  gap:12px;flex-wrap:wrap;
}
.admin-header h2{margin:0;font-size:18px}
.admin-tabs{
  display:flex;gap:6px;background:#fff;padding:0 20px 12px;
  border-bottom:1px solid var(--line);overflow-x:auto;
}
.admin-tab{
  padding:9px 18px;border-radius:10px;font-size:13px;color:#7c6970;
  white-space:nowrap;font-weight:500;
}
.admin-tab:hover{background:var(--pink-l);color:var(--pink-d)}
.admin-tab.active{background:var(--pink-d);color:#fff}
.admin-body{
  flex:1;overflow-y:auto;padding:22px;max-width:1200px;
  margin:0 auto;width:100%;
}
.admin-toolbar{
  display:flex;justify-content:space-between;align-items:center;
  gap:12px;margin-bottom:20px;flex-wrap:wrap;
}
.admin-toolbar h3{margin:0;font-size:16px}
.admin-table{
  width:100%;background:#fff;border-radius:14px;overflow:hidden;
  border-collapse:separate;border-spacing:0;font-size:13px;
}
.admin-table th,.admin-table td{padding:12px 10px;text-align:right;border-bottom:1px solid var(--line)}
.admin-table th{background:var(--pink-l);color:#7c6970;font-size:11.5px;font-weight:600}
.admin-table tr:last-child td{border-bottom:0}
.admin-table img{width:44px;height:44px;border-radius:10px;object-fit:cover}
.admin-btn{
  padding:6px 12px;border-radius:8px;font-size:11.5px;font-weight:600;
  background:var(--pink-l);color:var(--pink-d);margin-left:4px;
}
.admin-btn:hover{background:var(--pink);color:#fff}
.admin-btn.danger{background:#f4d8dc;color:#b0465a}
.admin-btn.danger:hover{background:#e8b8c0}
.image-grid{
  display:grid;grid-template-columns:repeat(auto-fill,minmax(90px,1fr));
  gap:10px;margin-top:10px;
}
.image-slot{
  position:relative;aspect-ratio:1;border-radius:12px;overflow:hidden;
  background:var(--pink-l);
}
.image-slot img{width:100%;height:100%;object-fit:cover}
.image-slot .remove{
  position:absolute;top:4px;right:4px;width:24px;height:24px;
  border-radius:50%;background:rgba(74,58,65,0.85);color:#fff;
  display:grid;place-items:center;font-size:14px;line-height:1;
}
.image-slot .remove:hover{background:#b0465a}
.upload-slot{
  aspect-ratio:1;border-radius:12px;border:2px dashed var(--pink);
  background:var(--pink-l);display:grid;place-items:center;
  cursor:pointer;color:var(--pink-d);font-size:28px;transition:.15s;
}
.upload-slot:hover{background:var(--pink);color:#fff}
.upload-slot input{display:none}
.settings-card{
  background:#fff;border-radius:14px;padding:22px;margin-bottom:16px;
}
.settings-card h4{margin:0 0 6px;font-size:14.5px}
.settings-card .hint{font-size:12px;color:var(--muted);margin:0 0 14px;line-height:1.9}

/* Empty state */
.empty{
  text-align:center;padding:60px 20px;color:var(--muted);font-size:14px;
  line-height:2.2;
}
.empty .ico{font-size:56px;margin-bottom:12px;opacity:.5}

/* Toast */
.toast{
  position:fixed;bottom:20px;left:20px;background:var(--ink);color:#fff;
  padding:14px 20px;border-radius:14px;font-size:13px;z-index:300;
  display:none;box-shadow:0 12px 30px rgba(0,0,0,0.3);
  max-width:min(360px,90vw);line-height:1.8;
}
.toast.show{display:block;animation:toastIn .3s}
@keyframes toastIn{from{opacity:0;transform:translateY(10px)}to{opacity:1;transform:none}}

@media(max-width:680px){
  .header-inner{height:64px;padding:0 14px}
  .brand-en{font-size:17px}
  .hero{padding:56px 16px}
  .hero h1{font-size:26px}
  .grid{grid-template-columns:repeat(2,1fr);gap:12px}
  .card-image{height:150px}
  .card-body{padding:12px}
  .card-body h3{font-size:12.5px}
  .row{grid-template-columns:1fr}
  .modal{padding:22px 18px}
  .campaigns{padding:36px 0 16px}
  .about{margin:20px 12px 40px;border-radius:22px}
  .admin-body{padding:14px}
  .admin-table th,.admin-table td{padding:9px 6px;font-size:11.5px}
}
</style>
</head>
<body>

<div class="ticker">
  <div class="ticker-inner" id="tickerInner"></div>
</div>

<header>
  <div class="header-inner">
    <button class="hamburger" onclick="openMenu()">☰</button>
    <div class="brand">
      <div class="brand-en" id="brandEn">ATRIAN</div>
      <div class="brand-fa" id="brandFa">عطریان · شیرینی دست‌ساز</div>
    </div>
    <div class="header-actions">
      <button class="icon-btn" onclick="openCart()">
        🛒<span class="badge" id="cartCount">0</span>
      </button>
      <button class="icon-btn" onclick="adminEntry()">⚙</button>
    </div>
  </div>
</header>

<!-- MENU DRAWER -->
<div class="drawer-bg" id="menuBg" onclick="closeMenu()"></div>
<aside class="drawer" id="menuDrawer">
  <div class="drawer-header">
    <div>
      <div class="brand-en" id="menuBrandEn">ATRIAN</div>
      <div style="font-size:11px;color:var(--muted);margin-top:6px" id="menuBrandFa">عطریان</div>
    </div>
    <button class="drawer-close" onclick="closeMenu()">×</button>
  </div>
  <div class="drawer-section">
    <h4>منوی اصلی</h4>
    <div class="drawer-item" onclick="goHome()"><span class="icon">🏠</span>صفحه اصلی</div>
    <div class="drawer-item" onclick="scrollToProducts()"><span class="icon">🍰</span>همه محصولات</div>
