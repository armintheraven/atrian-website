function drawBar(id, data, color, fmt){
  var c = document.getElementById(id);
  if(!c) return;
  var ctx = c.getContext('2d');
  var W = c.width, H = c.height;
  ctx.clearRect(0, 0, W, H);
  if(!data.length){
    ctx.fillStyle = '#c0aeb6';
    ctx.font = '14px Vazirmatn, Tahoma';
    ctx.textAlign = 'center';
    ctx.fillText('داده‌ای برای نمایش نیست', W/2, H/2);
    return;
  }
  var max = Math.max.apply(null, data.map(function(d){ return d.value; })) || 1;
  var pad = 50, gap = 20;
  var bw = (W - pad*2 - gap*(data.length-1)) / data.length;
  data.forEach(function(d, i){
    var h = (H - pad*1.8) * (d.value / max);
    var x = W - pad - (i+1)*bw - i*gap;
    var y = H - pad - h;
    ctx.fillStyle = color;
    roundRect(ctx, x, y, bw, h, 10);
    ctx.fill();
    ctx.fillStyle = '#4a3a41';
    ctx.font = '11px Vazirmatn, Tahoma';
    ctx.textAlign = 'center';
    ctx.fillText(String(d.label).slice(0, 14), x + bw/2, H - pad + 18);
    ctx.fillStyle = '#9b8891';
    ctx.font = '10px Vazirmatn, Tahoma';
    ctx.fillText(fmt(d.value), x + bw/2, y - 8);
  });
}
function roundRect(ctx, x, y, w, h, r){
  r = Math.min(r, w/2, h/2);
  ctx.beginPath();
  ctx.moveTo(x + r, y);
  ctx.arcTo(x + w, y, x + w, y + h, r);
  ctx.arcTo(x + w, y + h, x, y + h, r);
  ctx.arcTo(x, y + h, x, y, r);
  ctx.arcTo(x, y, x + w, y, r);
  ctx.closePath();
}

