  mkProduct(13, 'پک مدرسه کوچک', 'پک مدرسه', 65000, 75000, 100, 'پک زنگ تفریح: یک کوکی، یک شیرینی خشک و یک آبمیوه.'),
  mkProduct(14, 'پک مدرسه بزرگ', 'پک مدرسه', 95000, 110000, 80, 'پک کامل اردو: کیک، کوکی، شیرینی و نوشیدنی.'),
  mkProduct(15, 'پک اردو', 'پک مدرسه', 120000, 0, 60, 'پک مناسب اردوهای مدرسه با تنوع بیشتر.'),
  mkProduct(16, 'پک زنگ تفریح', 'پک مدرسه', 55000, 0, 120, 'پک ساده با کیک کوچک و آبمیوه. مناسب روزهای عادی.')
];

/* =========================================================
   STATE
   ========================================================= */
var state = {
  products: [],
  cart: [],
  orders: [],
  customOrders: [],
  settings: {}
};

function loadState(){
  try{
    var p = localStorage.getItem('atrian_v3_products');
    var c = localStorage.getItem('atrian_v3_cart');
    var o = localStorage.getItem('atrian_v3_orders');
    var co = localStorage.getItem('atrian_v3_custom');
    var s = localStorage.getItem('atrian_v3_settings');
    state.products = p ? JSON.parse(p) : JSON.parse(JSON.stringify(DEFAULT_PRODUCTS));
    state.cart = c ? JSON.parse(c) : [];
    state.orders = o ? JSON.parse(o) : [];
    state.customOrders = co ? JSON.parse(co) : [];
    state.settings = s ? JSON.parse(s) : JSON.parse(JSON.stringify(DEFAULTS_SETTINGS));
  }catch(e){
    state.products = JSON.parse(JSON.stringify(DEFAULT_PRODUCTS));
    state.cart = []; state.orders = []; state.customOrders = [];
    state.settings = JSON.parse(JSON.stringify(DEFAULTS_SETTINGS));
  }
}

function saveState(){
  try{
    localStorage.setItem('atrian_v3_products', JSON.stringify(state.products));
    localStorage.setItem('atrian_v3_cart', JSON.stringify(state.cart));
    localStorage.setItem('atrian_v3_orders', JSON.stringify(state.orders));
    localStorage.setItem('atrian_v3_custom', JSON.stringify(state.customOrders));
    localStorage.setItem('atrian_v3_settings', JSON.stringify(state.settings));
  }catch(e){
    showToast('حافظه مرورگر پر است. عکس‌های کمتری آپلود کن.');
  }
}

/* =========================================================
   HELPERS
   ========================================================= */
function fa(n){ return Number(n || 0).toLocaleString('fa-IR'); }
function money(n){ return fa(n) + ' تومان'; }
function esc(s){
  return String(s == null ? '' : s).replace(/[&<>"']/g, function(c){
    var map = {'&':'&amp;','<':'&lt;','>':'&gt;','"':'&quot;',"'":'&#39;'};
    return map[c];
  });
}
function uid(prefix){
  return (prefix || 'ID') + '-' + Date.now().toString().slice(-6);
}
function showToast(msg){
  var el = document.getElementById('toast');
  el.textContent = msg;
  el.classList.add('show');
  clearTimeout(showToast._t);
  showToast._t = setTimeout(function(){ el.classList.remove('show'); }, 2600);
}
function fileToDataUrl(file){
  return new Promise(function(resolve, reject){
    var r = new FileReader();
    r.onload = function(){ resolve(String(r.result)); };
    r.onerror = reject;
    r.readAsDataURL(file);
  });
}

