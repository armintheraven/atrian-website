function renderCartModal(){
  var host = document.getElementById('cartModal');
  if(!state.cart.length){
    host.innerHTML = '<button class="modal-close" onclick="closeCart()">×</button>' +
      '<h2>سبد خرید</h2>' +
      '<div class="empty"><div class="ico">🛒</div>سبدت خالیه<br>یه چیز خوشمزه انتخاب کن</div>' +
      '<button class="btn btn-primary btn-block" onclick="closeCart();scrollToProducts()">دیدن منو</button>';
    return;
  }
  var total = 0;
  var lines = state.cart.map(function(l, idx){
    var p = state.products.find(function(x){ return x.id === l.id; });
    if(!p) return '';
    total += p.price * l.qty;
    var img = (p.images && p.images[0]) || makeSvg('#e79bb0','#d4788f','cake');
    return '<div class="cart-line">' +
      '<img src="' + img + '" alt="">' +
