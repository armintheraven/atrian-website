/* =========================================================
   RENDER — PRODUCTS
   ========================================================= */
var currentFilter = 'همه';

function renderFilters(){
  var host = document.getElementById('filters');
  var all = ['همه'].concat(CATEGORIES);
  host.innerHTML = all.map(function(c){
    var active = (c === currentFilter) ? ' active' : '';
    return '<button class="filter-btn' + active + '" data-cat="' + esc(c) + '">' + c + '</button>';
  }).join('');
  host.querySelectorAll('button').forEach(function(b){
    b.onclick = function(){
      currentFilter = b.getAttribute('data-cat');
      renderFilters();
      renderProducts();
    };
  });
}

function renderProducts(){
  var host = document.getElementById('grid');
  var list = state.products.filter(function(p){ return p.active !== false; });
  if(currentFilter !== 'همه'){
    list = list.filter(function(p){ return p.category === currentFilter; });
  }
  if(!list.length){
    host.innerHTML = '<div class="empty" style="grid-column:1/-1"><div class="ico">🍽</div>محصولی در این دسته نیست</div>';
    return;
  }
  host.innerHTML = list.map(function(p){
    var img = (p.images && p.images[0]) || makeSvg('#e79bb0','#d4788f','cake');
    var out = Number(p.stock || 0) <= 0;
    var hasDiscount = Number(p.oldPrice || 0) > Number(p.price || 0) && Number(p.oldPrice) > 0;
    var badge = out
      ? '<span class="card-badge out">ناموجود</span>'
      : (hasDiscount ? '<span class="card-badge">تخفیف</span>' : '');
    var discountPct = hasDiscount
      ? Math.round((1 - p.price / p.oldPrice) * 100)
      : 0;
    var priceHtml = '<span class="now">' + money(p.price) + '</span>';
    if(hasDiscount){
      priceHtml += '<span class="old">' + money(p.oldPrice) + '</span>';
      priceHtml += '<span style="font-size:11px;background:var(--pink-l);color:var(--pink-d);padding:3px 8px;border-radius:8px;font-weight:700">' + fa(discountPct) + '٪</span>';
    }
